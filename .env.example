# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-uma-chave-secreta-com-openssl-rand-base64-32

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Microsoft OAuth (Entra ID / Azure AD)
AZURE_AD_CLIENT_ID=seu-azure-client-id
AZURE_AD_CLIENT_SECRET=seu-azure-client-secret
AZURE_AD_TENANT_ID=common  # ou seu tenant ID específico